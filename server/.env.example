# Скопируйте в .env и заполните
PORT=3001
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:3001
DB_PATH=data/elc.db

# Цена в минимальных единицах (копейки): 99000 = 990 ₽
PRICE_MINOR=99000
CURRENCY=RUB

# Длинные случайные строки, например: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=dfsdfasdasd
ADMIN_TOKEN=daifjsdfklqwe

# mock — тестовая «оплата» на сервере. Для реального провайдера замените адаптер в src/payment.ts
PAYMENT_PROVIDER=mock

# Почта. Если SMTP_HOST пуст — письма печатаются в консоль
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Elc <no-reply@elc.example>
