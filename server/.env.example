# Copy this file to .env and replace placeholders with strong random values.
# Never commit .env or share its contents.
PAYMENT_WEBHOOK_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
ADMIN_TOKEN=REPLACE_WITH_DIFFERENT_LONG_RANDOM_SECRET

PORT=3001
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:3001
DB_PATH=data/elc.db
PRICE_MINOR=40000
CURRENCY=RUB
PAYMENT_PROVIDER=mock

# Optional SMTP settings. Leave empty to disable email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Elc <no-reply@elc.example>
